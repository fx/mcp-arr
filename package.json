{
  "name": "mcp-arr",
  "version": "0.3.0",
  "description": "An MCP server for Sonarr, Radarr, and Prowlarr over stdio or Streamable HTTP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fx/mcp-arr.git"
  },
  "homepage": "https://github.com/fx/mcp-arr#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sonarr",
    "radarr",
    "prowlarr",
    "arr",
    "stdio",
    "streamable-http"
  ],
  "type": "module",
  "bin": {
    "mcp-arr": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js',0o755)\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test:run": "vitest run",
    "test": "npm run build && npm run test:run",
    "verify:package:run": "node scripts/verify-package.mjs",
    "verify:package": "npm run build && npm run verify:package:run",
    "start": "node dist/cli.js",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test:run && npm run verify:package:run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@types/node": "20.19.11",
    "typescript": "5.9.2",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  }
}
